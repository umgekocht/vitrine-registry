{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vitrine:schema:registry-featured:v1",
  "title": "Vitrine-Registry-Kuration (featured.json)",
  "description": "Schema fuer 'featured.json' im Katalog-Repo 'vitrine-registry' (M4/K1). Kuratierte Auswahl, erzeugt von registry/build-index.js aus dem optionalen 'featured'-Feld jedes packages/<id>.json-Eintrags.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Version dieses Kurations-Schemas. Aktuell fest auf 1.",
      "type": "integer",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "description": "Sortiert nach 'order' aufsteigend.",
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "note": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  }
}
